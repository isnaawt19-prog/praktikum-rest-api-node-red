    {
        "id": "fcdfce1204066bc2",
        "type": "function",
        "z": "66fa1f7c4b2f4156",
        "name": "Validasi dan Publish",
        "func": "\nvar body = msg.payload;\n\nif (!body.device || !body.action) {\n    msg.statusCode = 400;\n    msg.payload = {\n        status: 'error',\n        message: 'device dan action wajib diisi'\n    };\n\n    msg.headers = {\n        'Access-Control-Allow-Origin': '*'\n    };\n\n    return [msg, null];\n}\n\n// Mengirim perintah melalui MQTT\nvar mqttMsg = {\n    payload: body,\n    topic: 'iot/kontrol'\n};\n\nnode.send([null, mqttMsg]);\n\nmsg.statusCode = 200;\nmsg.payload = {\n    status: 'success',\n    message: 'Perintah terkirim',\n    sent: body\n};\n\nmsg.headers = {\n    'Access-Control-Allow-Origin': '*'\n};\n\nreturn [msg, null];\n",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
