    {
        "id": "9fe64665192e9809",
        "type": "function",
        "z": "66fa1f7c4b2f4156",
        "name": "Simpan Data Sensor",
        "func": "\n// Mengambil data sensor\nvar data = msg.payload;\n\n// Menambahkan waktu penerimaan\ndata.received = new Date().toISOString();\n\n// Menyimpan data sensor terakhir\nflow.set('lastSensor', data);\n\n// Menyimpan riwayat sensor\nvar history = flow.get('history') || [];\n\nhistory.push(data);\n\n// Maksimal 50 data\nif (history.length > 50) {\n    history.shift();\n}\n\nflow.set('history', history);\n\nreturn msg;\n",
